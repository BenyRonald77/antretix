# Konfigurasi stack untuk load test (dipakai dengan: docker compose --env-file loadtest.env ...)
LOADTEST_MODE=true
TURNSTILE_BYPASS=true
# k6 mengirim X-Forwarded-For palsu per VU agar rate limit per IP bisa diuji seperti banyak pengguna berbeda.
TRUST_PROXY=true
RL_GLOBAL_IP_PER_MIN=600
RL_STATUS_PER_MIN=30
RL_JOIN_PER_MIN=5
RL_CHECKOUT_PER_MIN=10
DB_POOL_SIZE=20
LOG_LEVEL=warn
