# --- Infrastruktur ---
DATABASE_URL=postgresql://antretix:antretix@localhost:5432/antretix?connection_limit=20
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
# Jumlah hop proxy yang dipercaya untuk X-Forwarded-For (1 = nginx). "true" = percaya semua (khusus load test).
TRUST_PROXY=1
AUTH_JWT_SECRET=ganti-dengan-secret-panjang-auth
QUEUE_JWT_SECRET=ganti-dengan-secret-panjang-antrean
CORS_ORIGIN=http://localhost:3000

# Cloudflare Turnstile. Kunci di bawah adalah test key resmi Cloudflare yang selalu lolos.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# true = lewati verifikasi Turnstile (HANYA untuk load test)
TURNSTILE_BYPASS=false

# Mock payment provider: secret HMAC untuk tanda tangan webhook
PAYMENT_WEBHOOK_SECRET=ganti-dengan-secret-webhook
PAYMENT_WEBHOOK_URL=http://localhost:4000/payments/webhook

# Mode load test: mengaktifkan /auth/dev-login (login tanpa password) dan /admin/events/:id/reset
LOADTEST_MODE=false

# Batas rate limit (per menit), bisa dinaikkan untuk skenario load test tertentu
RL_JOIN_PER_MIN=5
RL_STATUS_PER_MIN=30
RL_CHECKOUT_PER_MIN=10
RL_GLOBAL_IP_PER_MIN=120

# --- Worker ---
WORKER_METRICS_PORT=9101

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
